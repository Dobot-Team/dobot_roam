# OSS 配置文件模板
# 不要把本文件改名成 .env 后填入真实值并留在仓库里！
# 推荐做法：复制到仓库外部 ~/.config/embodvla/oss.env 后填写真实值。
#
#   mkdir -p ~/.config/embodvla
#   cp tools/oss_uploader/env.example ~/.config/embodvla/oss.env
#   # 编辑 ~/.config/embodvla/oss.env 填入真实凭证
#
# 代码默认读取 ~/.config/embodvla/oss.env；
# 也可以通过环境变量 EMBODVLA_OSS_CONFIG 指定其他路径。

# 阿里云 OSS 凭证（必填）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=your-oss-endpoint

# 断点续传配置（可选）
OSS_CHECKPOINT_DIR=.oss_checkpoints     # checkpoint 保存目录
OSS_PART_SIZE=10485760                  # 分片大小，单位字节，默认 10MB
OSS_MULTIPART_THRESHOLD=104857600       # 启用分片阈值，默认 100MB
OSS_NUM_THREADS=4                       # 并发上传线程数
OSS_MAX_RETRIES=3                       # 应用层失败重试次数

# 上传记录数据库（可选）
UPLOAD_RECORD_DB=upload_history.db      # SQLite 数据库文件路径
